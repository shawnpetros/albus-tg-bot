{
  "name": "tgclaude",
  "version": "0.1.0",
  "description": "Telegram your Claude Code. Long-polls Telegram, spawns claude -p per message with your MCP config and a pluggable persona.",
  "type": "module",
  "main": "bot.ts",
  "scripts": {
    "start": "bun run bot.ts",
    "dev": "bun --watch bot.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "test:docker": "docker compose run --rm test",
    "typecheck:docker": "docker compose run --rm typecheck"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "typescript": "^5.5.0"
  },
  "license": "UNLICENSED",
  "private": true
}
